import os
import json
import threading


class JarvisMemory:

    def __init__(self):

        base_dir = os.path.dirname(
            os.path.dirname(
                os.path.abspath(__file__)
            )
        )

        self.data_dir = os.path.join(
            base_dir,
            "data"
        )

        self.file_path = os.path.join(
            self.data_dir,
            "memory.json"
        )

        if not os.path.exists(self.data_dir):
            os.makedirs(self.data_dir)

        self.lock = threading.Lock()

        self.data = {
            "conversations": []
        }

        self.load()

    def load(self):

        if not os.path.exists(self.file_path):
            return

        try:

            with open(
                self.file_path,
                "r",
                encoding="utf-8"
            ) as file:

                loaded = json.load(file)

                if isinstance(loaded, dict):
                    self.data = loaded

        except Exception as error:

            print(
                "MEMORY LOAD ERROR:",
                error
            )

            self.data = {
                "conversations": []
            }

    def save(self):

        with self.lock:

            try:

                temp_file = (
                    self.file_path
                    + ".tmp"
                )

                with open(
                    temp_file,
                    "w",
                    encoding="utf-8"
                ) as file:

                    json.dump(
                        self.data,
                        file,
                        ensure_ascii=False,
                        indent=2
                    )

                if os.path.exists(
                    self.file_path
                ):
                    os.remove(
                        self.file_path
                    )

                os.rename(
                    temp_file,
                    self.file_path
                )

            except Exception as error:

                print(
                    "MEMORY SAVE ERROR:",
                    error
                )

    def add_message(
        self,
        role,
        text
    ):

        self.data.setdefault(
            "conversations",
            []
        )

        self.data["conversations"].append({
            "role": role,
            "text": text
        })

        # Keep the memory file from growing forever.
        if len(
            self.data["conversations"]
        ) > 1000:

            self.data["conversations"] = (
                self.data["conversations"][-1000:]
            )

        self.save()

    def get_recent(
        self,
        limit=20
    ):

        conversations = (
            self.data.get(
                "conversations",
                []
            )
        )

        return conversations[-limit:]

    def clear(self):

        self.data = {
            "conversations": []
        }

        self.save()

    def count(self):

        return len(
            self.data.get(
                "conversations",
                []
            )
        )
