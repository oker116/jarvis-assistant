import os
import json
import threading


class JarvisMemory:

    def __init__(self):

        base_dir = os.path.dirname(
            os.path.dirname(
                os.path.abspath(__file__)
            )
        )

        self.data_dir = os.path.join(
            base_dir,
            "data"
        )

        self.file_path = os.path.join(
            self.data_dir,
            "memory.json"
        )

        if not os.path.exists(self.data_dir):
            os.makedirs(self.data_dir)

        self.lock = threading.Lock()

        self.data = {
            "conversations": []
        }

        self.load()

    def load(self):

        if not os.path.exists(self.file_path):
            return

        try:

            with open(
                self.file_path,
                "r",
                encoding="utf-8"
            ) as file:

                loaded = json.load(file)

                if isinstance(loaded, dict):
                    self.data = loaded

        except Exception as error:

            print(
                "MEMORY LOAD ERROR:",
                error
            )

            self.data = {
                "conversations": []
            }

    def save(self):

        with self.lock:

            try:

                temp_file = (
                    self.file_path
                    + ".tmp"
                )

                with open(
                    temp_file,
                    "w",
                    encoding="utf-8"
                ) as file:

                    json.dump(
                        self.data,
                        file,
                        ensure_ascii=False,
                        indent=2
                    )

                if os.path.exists(
                    self.file_path
                ):
                    os.remove(
                        self.file_path
                    )

                os.rename(
                    temp_file,
                    self.file_path
                )

            except Exception as error:

                print(
                    "MEMORY SAVE ERROR:",
                    error
                )

    def add_message(
        self,
        role,
        text
    ):

        self.data.setdefault(
            "conversations",
            []
        )

        self.data["conversations"].append({
            "role": role,
            "text": text
        })

        # Keep the memory file from growing forever.
        if len(
            self.data["conversations"]
        ) > 1000:

            self.data["conversations"] = (
                self.data["conversations"][-1000:]
            )

        self.save()

    def learn_from_text(self, text):
        if not text:
            return

        text = text.strip()
        if not text:
            return

        import re

        self.data.setdefault("profile", {})
        self.data.setdefault("memories", [])

        # معلومات شخصية واضحة
        patterns = [
            (r"(?:اسمي|انا اسمي|أنا اسمي)\\s+([^،,.!?؟\\n]+)",
             "identity", "اسم المستخدم هو {}"),
            (r"(?:مواليد|مولود سنة|اتولدت سنة|اتولدت عام)\\s*(\\d{4})",
             "personal", "سنة ميلاد المستخدم {}"),
            (r"(?:عمري|سني|عندي)\\s+(\\d{1,3})",
             "personal", "عمر المستخدم {} سنة"),
            (r"(?:بلعب|ألعب|العب|بمارس|بتمرن)\\s+(.+)",
             "sport", "رياضة المستخدم: {}"),
            (r"(?:بحب|أحب|احب|هوايتي|هواياتي)\\s+(.+)",
             "interest", "من اهتمامات المستخدم: {}"),
        ]

        found = False

        for pattern, category, template in patterns:
            match = re.search(pattern, text, re.IGNORECASE)
            if match:
                value = match.group(1).strip()
                if value:
                    if category == "identity":
                        self.data["profile"]["name"] = value
                    elif category == "personal" and "ميلاد" in template:
                        self.data["profile"]["birth_year"] = value
                    elif category == "personal" and "عمر" in template:
                        self.data["profile"]["age"] = value

                    self._add_long_term_memory(
                        template.format(value),
                        category
                    )
                    found = True

        # -------------------------------------------------
        # ذاكرة عامة: خزن أي معلومة المستخدم يطلب حفظها
        # -------------------------------------------------
        save_patterns = [
            r"(?:خزن|احفظ|حفظ|افتكر|تذكر|خلي بالك إن|خلي بالك ان)\\s*(?:إن|ان)?\\s*(.+)"
        ]

        for pattern in save_patterns:
            match = re.search(pattern, text, re.IGNORECASE)
            if match:
                memory_text = match.group(1).strip()

                if memory_text:
                    self._add_long_term_memory(
                        memory_text,
                        "user_saved"
                    )

                found = True
                break

        self.save()

    def _add_long_term_memory(
        self,
        text,
        category="general"
    ):

        memories = self.data.setdefault(
            "memories",
            []
        )

        for memory in memories:

            if memory.get("text", "").strip().lower() == text.strip().lower():
                return

        memories.append({
            "text": text,
            "category": category
        })

    def get_long_term_context(
        self,
        limit=20
    ):

        memories = self.data.get(
            "memories",
            []
        )

        profile = self.data.get(
            "profile",
            {}
        )

        result = []

        for key, value in profile.items():

            result.append(
                f"{key}: {value}"
            )

        for memory in memories[-limit:]:

            text = memory.get(
                "text",
                ""
            )

            if text:
                result.append(text)

        return "\\n".join(result)

    def get_context(
        self,
        query="",
        limit=10
    ):

        output = []

        profile = self.data.get(
            "profile",
            {}
        )

        for key, value in profile.items():

            output.append(
                f"{key}: {value}"
            )

        memories = self.data.get(
            "memories",
            []
        )

        for memory in memories[-limit:]:

            memory_text = memory.get(
                "text",
                ""
            )

            if memory_text:
                output.append(
                    memory_text
                )

        return "\\n".join(output)

    def get_recent(
        self,
        limit=20
    ):

        conversations = (
            self.data.get(
                "conversations",
                []
            )
        )

        return conversations[-limit:]

    def clear(self):

        self.data = {
            "conversations": []
        }

        self.save()

    def count(self):

        return len(
            self.data.get(
                "conversations",
                []
            )
        )
