import os
import json
import threading
import re


class JarvisMemory:

    def __init__(self):
        base_dir = os.path.dirname(
            os.path.dirname(os.path.abspath(__file__))
        )

        self.data_dir = os.path.join(base_dir, "data")
        self.file_path = os.path.join(
            self.data_dir,
            "memory.json"
        )

        os.makedirs(self.data_dir, exist_ok=True)

        self.lock = threading.Lock()

        self.data = {
            "profile": {},
            "memories": [],
            "conversations": []
        }

        self.load()

    def load(self):
        if not os.path.exists(self.file_path):
            return

        try:
            with open(
                self.file_path,
                "r",
                encoding="utf-8"
            ) as f:
                loaded = json.load(f)

            if isinstance(loaded, dict):
                self.data.update(loaded)

        except Exception as error:
            print("[JARVIS MEMORY LOAD ERROR]", error)

    def save(self):
        with self.lock:
            try:
                temp = self.file_path + ".tmp"

                with open(
                    temp,
                    "w",
                    encoding="utf-8"
                ) as f:
                    json.dump(
                        self.data,
                        f,
                        ensure_ascii=False,
                        indent=2
                    )

                os.replace(temp, self.file_path)

            except Exception as error:
                print("[JARVIS MEMORY SAVE ERROR]", error)

    def add_message(self, role, text):
        conversations = self.data.setdefault(
            "conversations",
            []
        )

        conversations.append({
            "role": role,
            "text": text
        })

        if len(conversations) > 1000:
            del conversations[:-1000]

        self.save()

    def _add_memory(self, text, category="general"):
        text = text.strip()

        if not text:
            return

        memories = self.data.setdefault(
            "memories",
            []
        )

        normalized = text.lower()

        for memory in memories:
            if memory.get("text", "").strip().lower() == normalized:
                return

        memories.append({
            "text": text,
            "category": category
        })

        self.save()

    def learn_from_text(self, text):
        """
        يتعلم تلقائيًا من كلام المستخدم.
        لا يحتاج المستخدم أن يقول: احفظ / خزن.
        """

        if not text:
            return

        text = text.strip()

        if not text:
            return

        self.data.setdefault("profile", {})
        self.data.setdefault("memories", [])

        found = False

        # الاسم
        patterns = [
            (
                r"(?:اسمي|انا اسمي|أنا اسمي)\s+"
                r"([^،,.!?؟\n]+)",
                "identity",
                "اسم المستخدم هو {}"
            ),

            # سنة الميلاد
            (
                r"(?:مواليد|مولود سنة|اتولدت سنة|اتولدت عام)\s*"
                r"(\d{4})",
                "personal",
                "سنة ميلاد المستخدم {}"
            ),

            # العمر
            (
                r"(?:عمري|سني|عندي)\s+"
                r"(\d{1,3})\s*(?:سنة|سنين|عام)?",
                "personal",
                "عمر المستخدم {} سنة"
            ),

            # الدراسة
            (
                r"(?:بدرس|بدرس في|انا بدرس|أنا بدرس)\s+(.+)",
                "education",
                "دراسة المستخدم: {}"
            ),

            # العمل
            (
                r"(?:بشتغل|أعمل|بعمل|شغلي|وظيفتي)\s+(.+)",
                "work",
                "عمل المستخدم: {}"
            ),

            # الرياضة
            (
                r"(?:بلعب|ألعب|العب|بمارس|بتمرن)\s+(.+)",
                "sport",
                "رياضة المستخدم: {}"
            ),

            # الحب والاهتمامات
            (
                r"(?:بحب|أحب|احب|هوايتي|هواياتي)\s+(.+)",
                "interest",
                "اهتمامات المستخدم: {}"
            ),

            # الهدف
            (
                r"(?:هدفي|هدفي ان|هدفي إن)\s+(.+)",
                "goal",
                "هدف المستخدم: {}"
            ),

            # السكن
            (
                r"(?:ساكن في|عايش في|من|بلدي)\s+(.+)",
                "location",
                "مكان المستخدم: {}"
            )
        ]

        for pattern, category, template in patterns:

            match = re.search(
                pattern,
                text,
                re.IGNORECASE
            )

            if not match:
                continue

            value = match.group(1).strip()

            if not value:
                continue

            # تنظيف بسيط
            value = re.split(
                r"\s+(?:و|وعندي|وعمري|مواليد|لكن|بس)\s+",
                value,
                maxsplit=1
            )[0].strip()

            if not value:
                continue

            # معلومات البروفايل الأساسية
            if category == "identity":
                self.data["profile"]["name"] = value

            elif category == "personal":
                if "ميلاد" in template:
                    self.data["profile"]["birth_year"] = value
                elif "عمر" in template:
                    self.data["profile"]["age"] = value

            self._add_memory(
                template.format(value),
                category
            )

            found = True

        # -----------------------------------------
        # جمل شخصية واضحة بدون كلمة "احفظ"
        # -----------------------------------------

        automatic_patterns = [

            (
                r"(?:أنا|انا)\s+بحب\s+(.+)",
                "interest",
                "المستخدم يحب {}"
            ),

            (
                r"(?:أنا|انا)\s+بكره\s+(.+)",
                "preference",
                "المستخدم لا يحب {}"
            ),

            (
                r"(?:أنا|انا)\s+أفضل\s+(.+)",
                "preference",
                "المستخدم يفضل {}"
            ),

            (
                r"(?:أنا|انا)\s+عايز\s+(.+)",
                "goal",
                "المستخدم يريد {}"
            ),

            (
                r"(?:أنا|انا)\s+نفسي\s+في\s+(.+)",
                "goal",
                "المستخدم يتمنى {}"
            )
        ]

        for pattern, category, template in automatic_patterns:

            match = re.search(
                pattern,
                text,
                re.IGNORECASE
            )

            if match:
                value = match.group(1).strip()

                if value:
                    self._add_memory(
                        template.format(value),
                        category
                    )
                    found = True

        # -----------------------------------------
        # أي جملة فيها معلومة شخصية واضحة
        # -----------------------------------------

        personal_markers = [
            "عندي",
            "معايا",
            "بملك",
            "بستخدم",
            "عندي مشكلة",
            "مشكلتي",
            "خطتي",
            "مشروعي",
            "هدفي",
            "حلمي",
            "بحاول",
            "بخطط"
        ]

        if not found:
            for marker in personal_markers:

                if marker in text:

                    self._add_memory(
                        text,
                        "personal"
                    )

                    found = True
                    break

        # الحفظ يتم تلقائيًا
        self.save()

    def get_long_term_context(self, limit=100):
        result = []

        profile = self.data.get(
            "profile",
            {}
        )

        for key, value in profile.items():
            result.append(
                f"{key}: {value}"
            )

        memories = self.data.get(
            "memories",
            []
        )

        for memory in memories[-limit:]:

            text = memory.get(
                "text",
                ""
            )

            if text:
                result.append(text)

        return "\n".join(result)

    def get_context(self, query="", limit=50):
        return self.get_long_term_context(limit)

    def get_recent(self, limit=20):
        conversations = self.data.get(
            "conversations",
            []
        )

        return conversations[-limit:]

    def clear(self):
        self.data = {
            "profile": {},
            "memories": [],
            "conversations": []
        }

        self.save()

    def count(self):
        return len(
            self.data.get(
                "conversations",
                []
            )
        )
