import os
import json
import requests
import sys


ROOT_DIR = os.path.dirname(
    os.path.dirname(
        os.path.abspath(__file__)
    )
)

if ROOT_DIR not in sys.path:
    sys.path.insert(
        0,
        ROOT_DIR
    )


from memory.memory import JarvisMemory


class JarvisBrain:

    def __init__(self):

        self.api_key = os.environ.get(
            "GEMINI_API_KEY"
        )

        if not self.api_key:
            raise RuntimeError(
                "GEMINI_API_KEY is missing"
            )

        self.url = (
            "https://generativelanguage.googleapis.com/"
            "v1beta/models/gemini-3.5-flash:generateContent"
        )

        self.memory = JarvisMemory()

        self.system_prompt = (
            "You are JARVIS, a personal AI assistant. "
            "You are intelligent, precise, analytical and helpful. "
            "If the user speaks Arabic, answer in Arabic. "
            "If the user speaks English, answer in English. "
            "Be natural and conversational. "
            "Use the conversation memory when it is relevant. "
            "Do not claim to have performed an action unless "
            "the system actually performed it."
        )

    def build_contents(
        self,
        user_text
    ):

        contents = []

        contents.append({
            "role": "user",
            "parts": [
                {
                    "text": self.system_prompt
                }
            ]
        })

        recent = self.memory.get_recent(
            limit=20
        )

        for item in recent:

            role = item.get(
                "role"
            )

            text = item.get(
                "text",
                ""
            )

            if role not in [
                "user",
                "model"
            ]:
                continue

            if not text:
                continue

            contents.append({
                "role": role,
                "parts": [
                    {
                        "text": text
                    }
                ]
            })

        contents.append({
            "role": "user",
            "parts": [
                {
                    "text": user_text
                }
            ]
        })

        return contents

    def ask(
        self,
        user_text
    ):

        user_text = user_text.strip()

        if not user_text:
            return ""

        contents = self.build_contents(
            user_text
        )

        data = {
            "contents": contents,
            "generationConfig": {
                "temperature": 0.75,
                "maxOutputTokens": 2048
            }
        }

        headers = {
            "Content-Type": "application/json"
        }

        params = {
            "key": self.api_key
        }

        try:

            response = requests.post(
                self.url,
                params=params,
                headers=headers,
                data=json.dumps(data),
                timeout=60
            )

            if response.status_code != 200:

                print(
                    "GEMINI HTTP ERROR:",
                    response.status_code
                )

                print(
                    response.text
                )

                return (
                    "I could not connect "
                    "to the AI engine."
                )

            result = response.json()

            candidates = result.get(
                "candidates",
                []
            )

            if not candidates:

                print(
                    "NO CANDIDATES:"
                )

                print(result)

                return (
                    "I received an empty "
                    "AI response."
                )

            content = (
                candidates[0]
                .get(
                    "content",
                    {}
                )
            )

            parts = content.get(
                "parts",
                []
            )

            if not parts:
                return (
                    "I received an empty "
                    "AI response."
                )

            answer = parts[0].get(
                "text",
                ""
            )

            if not answer:
                return (
                    "I received an empty "
                    "AI response."
                )

            self.memory.add_message(
                "user",
                user_text
            )

            self.memory.add_message(
                "model",
                answer
            )

            return answer.strip()

        except requests.exceptions.Timeout:

            return (
                "The connection timed out."
            )

        except requests.exceptions.ConnectionError:

            return (
                "I cannot connect to "
                "the internet."
            )

        except Exception as error:

            print(
                "JARVIS ERROR:",
                error
            )

            return (
                "An unexpected error "
                "occurred."
            )


if __name__ == "__main__":

    print("=" * 50)
    print("JARVIS BRAIN")
    print("Persistent Memory Enabled")
    print("=" * 50)

    brain = JarvisBrain()

    while True:

        text = input(
            "YOU > "
        ).strip()

        if not text:
            continue

        if text.lower() in [
            "exit",
            "quit"
        ]:
            break

        answer = brain.ask(
            text
        )

        print("")
        print(
            "JARVIS >"
        )
        print(answer)
        print("")